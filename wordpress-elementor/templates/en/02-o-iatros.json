          "align": "left",
          "title_color": "#1A3153",
          "_margin": {
           "unit": "px",
           "top": "0",
           "right": "0",
           "bottom": "16",
           "left": "0",
           "isLinked": false
          },
          "typography_typography": "custom",
          "typography_font_family": "Noto Serif",
          "typography_font_size": {
