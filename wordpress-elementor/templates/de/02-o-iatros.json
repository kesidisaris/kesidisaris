        {
         "id": "0bbb2599",
         "elType": "widget",
         "settings": {
          "editor": "Sicherheit, Betreuung und Komfort der Patienten in jeder Phase der Untersuchung haben für unser Team oberste Priorität. Von der Vorbereitung und dem Empfang über die Überwachung während der Endoskopie bis zur Erholung nach der Sedierung steht das Pflegepersonal dem Patienten stets zur Seite.",
          "text_color": "#2B3445",
          "align": "left",
          "_margin": {
           "unit": "px",
           "top": "0",
           "right": "0",
           "bottom": "14",
           "left": "0",
           "isLinked": false
          },
          "typography_typography": "custom",
