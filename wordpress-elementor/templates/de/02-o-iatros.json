        },
        {
         "id": "a9488d99",
         "elType": "widget",
         "settings": {
          "editor": "Die enge Zusammenarbeit zwischen Arzt und Pflegepersonal trägt zu einem reibungslosen und sicheren Ablauf der endoskopischen Untersuchungen bei, mit kontinuierlicher Überwachung und sofortiger Reaktion auf die Bedürfnisse jedes Patienten.",
          "text_color": "#2B3445",
          "align": "left",
          "_margin": {
           "unit": "px",
           "top": "0",
           "right": "0",
           "bottom": "14",
           "left": "0",
